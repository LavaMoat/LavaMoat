{
  "name": "@lavamoat/policy",
  "version": "0.0.0",
  "type": "module",
  "description": "LavaMoat policy schema and validation",
  "repository": {
    "directory": "packages/policy",
    "type": "git",
    "url": "git+https://github.com/LavaMoat/LavaMoat.git"
  },
  "homepage": "https://lavamoat.github.io",
  "bugs": "https://github.com/LavaMoat/LavaMoat/issues",
  "author": "LavaMoat Project",
  "license": "MIT",
  "engines": {
    "node": "^22.5.1 || ^24.0.0 || ^26.0.0",
    "npm": ">=9.0.0"
  },
  "exports": {
    ".": {
      "import": "./src/index.js",
      "types": "./src/index.d.ts"
    },
    "./package.json": "./package.json",
    "./lavamoat-policy.schema.json": "./lavamoat-policy.schema.json",
    "./schema.js": {
      "import": "./src/policy-schema.js",
      "types": "./src/policy-schema.d.ts"
    },
    "./types.js": {
      "import": "./src/types.js",
      "types": "./src/types.d.ts"
    }
  },
  "files": [
    "CHANGELOG.md",
    "lavamoat-policy.schema.json",
    "src",
    "!*.tsbuildinfo",
    "!src/tsconfig.json"
  ],
  "scripts": {
    "build": "node ./scripts/create-policy-schema.ts",
    "lint:deps": "depcheck",
    "rebuild": "npm run build",
    "test": "npm run test:run",
    "test:cover": "c8 npm test",
    "test:run": "node --test \"test/*.spec.ts\"",
    "test:update-snapshots": "node --test --test-update-snapshots \"test/*.spec.ts\""
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "json-stable-stringify": "1.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
