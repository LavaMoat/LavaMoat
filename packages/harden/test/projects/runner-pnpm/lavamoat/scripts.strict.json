{
  "notes": "Denies all powerful IO capabilities that a linter script should not need.",
  "nodeOptions": {
    "--permission": true,
    "--allow-fs-read": ["./"],
    "--allow-fs-write": ["./"],
    "--allow-child-process": false,
    "--allow-net": false,
    "--allow-worker": false,
    "--allow-addons": false,
    "--allow-wasi": false,
    "--allow-inspector": false
  }
}
